<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 앱스토어 심사 5.1.1 — 수집 데이터 유형을 선언해야 한다.
       미성년 사용자를 다루므로 특히 엄격하게 본다. -->
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <dict>
      <!-- 학습 진도·정답률 -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeProductInteraction</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <dict>
      <!-- 학생이 쓴 답안·풀이 텍스트와 제출 PDF 등 기타 사용자 콘텐츠. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <dict>
      <!-- GOAT Arena의 매치 참가·상대 매칭·답안·승패·티어·GP처럼
           계정에 연결해 저장하는 멀티플레이 경기 콘텐츠. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeGameplayContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <dict>
      <!-- GOAT Arena·주간 모의고사 소명에서 사용자가 명시적으로 제출한
           시험지/풀이 사진은 계정에 연결해 서버 검토 자료로 보관한다. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <dict>
      <!-- 2026-08-16 추가. 빠져 있던 항목이다.
           가입 화면(AuthScreen.swift:241, :453)이 실명과 닉네임을 받아 서버로 보낸다.
           선언과 실제가 어긋나면 심사에서 걸리고, App Store Connect 개인정보
           설문과도 반드시 같은 답이어야 한다. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeName</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <dict>
      <!-- 공개 닉네임, 서버 계정 ID와 StoreKit appAccountToken처럼 특정
           계정의 로그인·구매·권한을 연결하는 계정 수준 식별자. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeUserID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <dict>
      <!-- App Store 거래 JWS와 상품 ID를 서버 권한에 연결해 구매·복원·환불을
           처리한다. 카드·결제수단 정보는 Apple이 처리하며 앱은 받지 않는다. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <dict>
      <!-- 학교·학년(AuthScreen.swift:455 schoolGrade, 학교코드)과
           생년월일(AuthScreen.swift:319 birthDate → :571 birthDateString).
           애플의 표준 분류에 '학적'도 '생년월일'도 없어 기타로 함께 선언한다.

           생년월일을 여기 적어 두는 이유: App Store Connect 의 개인정보 설문과
           이 매니페스트가 어긋나면 그 자체가 반려 사유다. 타입은 OtherDataTypes
           하나로 덮이지만, 무엇을 받는지 열거해 두지 않으면 설문에 답할 때
           근거가 없어 빠뜨리게 된다.

           쓰임: 진도 기준 학년 산정, 학교 단위 랭킹, 미성년자 결제 고지 판정. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
  </array>

  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array><string>CA92.1</string></array>
    </dict>
    <dict>
      <!-- 로컬 AI 작업·모델 파일·진단 산출물의 정리/복구 순서를 정하기 위해
           앱 컨테이너 안 파일의 수정 시각만 읽는다. 값은 기기 밖으로 보내지 않는다. -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array><string>C617.1</string></array>
    </dict>
    <dict>
      <!-- 사용자가 로컬 AI 모델을 내려받기 전에 저장 공간이 충분한지 확인하고,
           부족하면 다운로드를 시작하지 않고 화면에 필요한 용량을 안내한다. -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array><string>E174.1</string></array>
    </dict>
  </array>
</dict>
</plist>
